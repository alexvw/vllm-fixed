{
  "tests": [
    {
      "name": "laguna_int4_rtx_pro_6000_smoke_test",
      "input": {
        "openai_route": "/v1/chat/completions",
        "openai_input": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with exactly: ready"
            }
          ],
          "max_tokens": 8,
          "temperature": 0
        }
      },
      "timeout": 1200000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA RTX PRO 6000 Blackwell Server Edition",
    "gpuCount": 1,
    "env": [
      {
        "key": "MODEL_NAME",
        "value": "poolside/Laguna-S-2.1-INT4"
      },
      {
        "key": "MAX_MODEL_LEN",
        "value": "32768"
      }
    ],
    "allowedCudaVersions": ["13.0"]
  }
}
